rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getGroup(groupId) { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
    function isOwner(groupId) { return isSignedIn() && request.auth.uid == getGroup(groupId).ownerId; }
    function isApprovedEditor(groupId) { return isSignedIn() && request.auth.uid in getGroup(groupId).approvedEditors; }
    function canEdit(groupId) { return isOwner(groupId) || isApprovedEditor(groupId); }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /portfolio/{itemId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /portfolio_history/{id} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && (canEdit(groupId) || (resource.data.members != null && request.auth.uid in resource.data.members));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(groupId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
      match /transactions/{txId} {
        allow read: if isSignedIn() && (canEdit(groupId) || (getGroup(groupId).members != null && request.auth.uid in getGroup(groupId).members));
        allow create: if canEdit(groupId);
        allow update: if canEdit(groupId) && request.resource.data.amount == resource.data.amount && request.resource.data.paidBy == resource.data.paidBy;
        allow delete: if isOwner(groupId);
      }
      match /accessRequests/{requestUid} {
        allow read: if isSignedIn() && (request.auth.uid == requestUid || isOwner(groupId));
        allow create: if isSignedIn() && request.auth.uid == requestUid && request.resource.data.uid == requestUid && request.resource.data.status == 'pending';
        allow update: if isOwner(groupId);
        allow delete: if false;
      }
    }
  }
}